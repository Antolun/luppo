PisiPackage {
    Source {
        Name "pisi"
        Homepage "https://github.com/TeknoAnka/pisi"
        Packager {
            Name "TeknoAnka"
            Email "admins@teknoanka.com"
        }
        License "GPL-3.0-or-later"
        Summary "LupuS/PiSiLinux package manager (Rust implementation)"
        Description "pisi is a complete rewrite of the PiSi package manager from Python to Rust. It handles package building, dependency resolution, installation, and removal with improved performance."
        PartOf "system.base"
        Provides {
            Isa "app:console"
        }
            Archive sha1sum="to-be-filled" {
                "https://github.com/TeknoAnka/pisi/archive/v3.0.0.tar.gz"
            }
        BuildDependencies {
        Dependency "rust" version-from=">=1.70.0"
        Dependency "python3" version-from=">=3.8"
        Dependency "python3-devel" version-from=">=3.8"
        Dependency "dbus"
        Dependency "dbus-devel"
        Dependency "glibc-devel"
        Dependency "openssl-devel"
        Dependency "xz-devel"
        Dependency "zlib-devel"
        Dependency "bzip2-devel"
        Dependency "zstd-devel"
        }
    }
    Package {
        Name "pisi"
        RuntimeDependencies {
        Dependency "python3" version-from=">=3.8"
        Dependency "dbus"
        Dependency "glibc"
        Dependency "openssl"
        Dependency "xz"
        Dependency "zlib"
        Dependency "bzip2"
        Dependency "zstd"
        }
        Files {
                Path "/usr/bin/pisi" file-type="executable"
                Path "/usr/bin/lspisi" file-type="executable"
                Path "/usr/bin/unpisi" file-type="executable"
                Path "/usr/bin/resolve_core_order" file-type="executable"
            }
        Actions {
                steps "cargo build --release"
                steps "install -Dm755 target/release/pisi {install_root}/usr/bin/pisi"
                steps "install -Dm755 target/release/lspisi {install_root}/usr/bin/lspisi"
                steps "install -Dm755 target/release/unpisi {install_root}/usr/bin/unpisi"
                steps "install -Dm755 target/release/resolve_core_order {install_root}/usr/bin/resolve_core_order"
            }
    }
    History {
        Update release=1 date="2026-06-23" {
            Version "3.0.0"
            Comment "Initial release of pisi as a system package."
            Name "TeknoAnka"
            Email "admins@teknoanka.com"
        }
    }
}
