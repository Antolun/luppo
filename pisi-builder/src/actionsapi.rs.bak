/// Linux Kernel modülleri için kurulum adımını uygular.
pub fn kernel_module_install(
    kernel_ver: &str,
    dest_dir: &str,
    args: &[&str],
) -> Result<(), String> {
    let kdir = format!("/lib/modules/{}/build", kernel_ver);
    let inst_dir = format!("{}/lib/modules/{}/extra", dest_dir, kernel_ver);
    let destdir_arg = format!("INSTALL_MOD_PATH={}", dest_dir);
    let jobs = get::make_jobs();

    if !Path::new(&inst_dir).exists() {
        fs::create_dir_all(&inst_dir)
            .map_err(|e| t!("api_err_kernel_dir", error = e).to_string())?;
    }

    let mut default_args = vec![
        "-j",
        jobs.as_str(),
        "-C",
        kdir.as_str(),
        "M=$(pwd)",
        destdir_arg.as_str(),
        "modules_install",
    ];
    default_args.extend_from_slice(args);
    println!("{}", t!("api_kernel_install"));
    run_command("make", &default_args)
}

/// Rust projeleri için inşa adımını (cargo build) uygular.
pub fn cargo_build(args: &[&str]) -> Result<(), String> {
    // Sandbox dostu CARGO_HOME: Mevcut çalışma dizini içinde .cargo klasörü.
    // Bu, indirilen crate'lerin sandbox dışına sızmasını önler ve izolasyon sağlar.
    let cargo_home = env::current_dir()
        .map_err(|e| e.to_string())?
        .join(".cargo");
    if !cargo_home.exists() {
        fs::create_dir_all(&cargo_home).map_err(|e| e.to_string())?;
    }
    set_env("CARGO_HOME", cargo_home.to_string_lossy().as_ref());

    let jobs = get::make_jobs();
    let mut default_args = vec!["build", "--release", "--jobs", jobs.as_str()];
    default_args.extend_from_slice(args);

    println!("{}", t!("api_cargo_build"));
    run_command("cargo", &default_args)
}

/// Rust projeleri için kurulum adımını (cargo install) uygular.
pub fn cargo_install(dest_dir: &str, args: &[&str]) -> Result<(), String> {
    // İnşa aşamasındakiyle aynı CARGO_HOME kullanılmalı.
    let cargo_home = env::current_dir()
        .map_err(|e| e.to_string())?
        .join(".cargo");
    if !cargo_home.exists() {
        fs::create_dir_all(&cargo_home).map_err(|e| e.to_string())?;
    }
    set_env("CARGO_HOME", cargo_home.to_string_lossy().as_ref());

    // Pisi standartlarına göre /usr altına kurulum yapılması için root yolu ayarlanır.
    // Cargo --root bayrağı, bin/ dizinini bu yolun hemen altına oluşturur.
    let install_root = Path::new(dest_dir).join("usr");
    let root_str = install_root.to_string_lossy();
    let jobs = get::make_jobs();
    let mut default_args = vec![
        "install",
        "--jobs",
        jobs.as_str(),
        "--path",
        ".",
        "--root",
        &root_str,
    ];
    default_args.extend_from_slice(args);

    println!("{}", t!("api_cargo_install", dest = dest_dir));
    run_command("cargo", &default_args)
}

/// Belirtilen hedef için bir sembolik bağ (symlink) oluşturur.
pub fn symlink<P: AsRef<Path>, Q: AsRef<Path>>(source: P, link_name: Q) -> Result<(), String> {
    let src = source.as_ref();
    let dst = link_name.as_ref();
    println!(
        "{}",
        t!("api_symlink", src = src.display(), dest = dst.display())
    );

    #[cfg(unix)]
    return std::os::unix::fs::symlink(src, dst)
        .map_err(|e| t!("api_err_symlink", error = e).to_string());

    #[cfg(not(unix))]
    Err(t!("api_err_symlink_unix").to_string())
}

/// Dosya veya dizin izinlerini (chmod) ayarlar.
pub fn set_perms<P: AsRef<Path>>(path: P, mode: u32) -> Result<(), String> {
    let p = path.as_ref();
    println!(
        "{}",
        t!(
            "api_perms",
            path = p.display(),
            mode = format!("{:o}", mode)
        )
    );

    let path_str = p.to_string_lossy();
    if path_str.contains('*') || path_str.contains('?') {
        let mut matched_any = false;
        if let Ok(entries) = glob::glob(&path_str) {
            for entry_path in entries.flatten() {
                matched_any = true;
                use std::os::unix::fs::PermissionsExt;
                fs::set_permissions(&entry_path, fs::Permissions::from_mode(mode)).map_err(
                    |e| t!("api_err_perms", path = entry_path.display(), error = e).to_string(),
                )?;
            }
        }
        if !matched_any {
            return Err(t!(
                "api_err_perms",
                path = p.display(),
                error = "No matching files found for glob"
            )
            .to_string());
        }
        Ok(())
    } else {
        use std::os::unix::fs::PermissionsExt;
        fs::set_permissions(p, fs::Permissions::from_mode(mode))
            .map_err(|e| t!("api_err_perms", path = p.display(), error = e).to_string())
    }
}

/// Bir dosyayı veya dizini yeni bir konuma taşır veya adını değiştirir.
pub fn move_path<P: AsRef<Path>, Q: AsRef<Path>>(source: P, destination: Q) -> Result<(), String> {
    let src = source.as_ref();
    let dst = destination.as_ref();
    println!(
        "{}",
        t!("api_move", src = src.display(), dest = dst.display())
    );

    fs::rename(src, dst).map_err(|e| {
        t!(
            "api_err_move",
            src = src.display(),
            dest = dst.display(),
            error = e
        )
        .to_string()
    })
}

/// Bir dosyayı veya dizini (içeriğiyle birlikte) siler.
pub fn remove_path<P: AsRef<Path>>(path: P) -> Result<(), String> {
    let p = path.as_ref();
    println!("{}", t!("api_remove", path = p.display()));

    let path_str = p.to_string_lossy();
    if path_str.contains('*') || path_str.contains('?') {
        if let Ok(entries) = glob::glob(&path_str) {
            for entry_path in entries.flatten() {
                if entry_path.is_dir() {
                    let _ = fs::remove_dir_all(&entry_path);
                } else {
                    let _ = fs::remove_file(&entry_path);
                }
            }
        }
        Ok(())
    } else {
        if !p.exists() && !p.is_symlink() {
            return Ok(());
        }

        let result = if p.is_dir() {
            fs::remove_dir_all(p)
        } else {
            fs::remove_file(p)
        };

        result.map_err(|e| t!("api_err_remove", path = p.display(), error = e).to_string())
    }
}

/// Eski kaynak kodlardaki config.guess ve config.sub dosyalarını sistemdekilerle günceller.
/// (libtools.gnuconfig_update muadili)
pub fn gnuconfig_update() -> Result<(), String> {
    println!("{}", t!("api_gnuconfig"));
    let gnuconfig_dir = Path::new("/usr/share/gnuconfig");
    if !gnuconfig_dir.exists() {
        return Err(t!("api_err_gnuconfig_dir").to_string());
    }

    // Kaynak dizininde config.guess/sub olan yerleri bulup üzerine yazar
    let files = ["config.guess", "config.sub"];
    for entry in fs::read_dir(".").map_err(|e| e.to_string())?.flatten() {
        let path = entry.path();
        if path.is_dir() {
            continue;
        }

        if let Some(name) = path.file_name().and_then(|n| n.to_str()) {
            if files.contains(&name) {
                let src = gnuconfig_dir.join(name);
                fs::copy(src, &path).map_err(|e| e.to_string())?;
                println!("{}", t!("api_gnuconfig_ok", path = path.display()));
            }
        }
    }
    Ok(())
}

/// Kurulum dizinindeki .pc dosyalarındaki yolları düzeltir.
/// (pkgconfig.py ve autotools.fixpc muadili)
pub fn fix_pkgconfig(dest_root: &str) -> Result<(), String> {
    println!("{}", t!("api_fix_pc"));
    let pc_dir = Path::new(dest_root).join("usr/lib/pkgconfig");
    if !pc_dir.exists() {
        return Ok(());
    }

    for entry in fs::read_dir(pc_dir).map_err(|e| e.to_string())?.flatten() {
        if let Ok(file_type) = entry.file_type() {
            if file_type.is_symlink() || !file_type.is_file() {
                continue;
            }
        }
        let path = entry.path();
        if path.extension().is_some_and(|ext| ext == "pc") {
            dosed(&path, dest_root, "", false)?; // install_root referanslarını temizle
        }
    }
    Ok(())
}

