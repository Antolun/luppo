use md5;
use rust_i18n::t;
use sha1::{Digest, Sha1};
use sha2::Sha256;
use std::env;
use std::fs::{self, OpenOptions};
use std::io::{self, BufRead, BufReader, Read, Write};
use std::path::Path;
use std::process::{Command, Stdio};
use std::sync::{Arc, Mutex};
use std::thread;
rust_i18n::i18n!("../../locales", fallback = "tr");

// --- YARDIMCI FONKSİYON ---
/// Belirtilen komutu çalıştırır ve çıktıyı yakalar.
/// Başarılı olursa Ok(()), başarısız olursa anlamlı bir hata mesajı döndürür.
pub fn run_command(name: &str, args: &[&str]) -> Result<(), String> {
    // Log dosyası yolunu çevre değişkeninden al
    let log_file_path = env::var("PISI_BUILD_LOG").ok();
    let full_command = if args.is_empty() {
        name.to_string()
    } else {
        format!("{} {}", name, args.join(" "))
    };

    // Log dosyası varsa aç ve Arc/Mutex ile sarmala (paralel erişim için)
    let log_file = log_file_path
        .and_then(|path| OpenOptions::new().create(true).append(true).open(path).ok())
        .map(|f| Arc::new(Mutex::new(f)));

    if let Some(ref f) = log_file {
        let mut f = f.lock().unwrap();
        writeln!(f, "\n[RUN]: {}", full_command).ok();
    }

    println!("DEBUG RUN_COMMAND: name={}, cwd={:?}, PATH={:?}", name, std::env::current_dir(), std::env::var("PATH"));
    let mut child = Command::new("sh")
        .arg("-c")
        .arg(&full_command)
        .stdin(Stdio::null())
        .stdout(Stdio::piped())
        .stderr(Stdio::piped())
        .spawn()
        .map_err(|e| t!("api_err_spawn", name = name, error = e).to_string())?;

    let stdout_pipe = child.stdout.take().ok_or("Stdout pipe alınamadı")?;
    let stderr_pipe = child.stderr.take().ok_or("Stderr pipe alınamadı")?;

    let is_verbose = env::var("VERBOSE").is_ok() || env::var("PISI_DEBUG").is_ok();
    let log_file_stdout = log_file.clone();
    let log_file_stderr = log_file.clone();

    // Çıktıyı canlı olarak okumak için thread'ler kullanıyoruz
    let stdout_thread = thread::spawn(move || {
        let reader = BufReader::new(stdout_pipe);
        let mut output = String::new();
        for l in reader.lines().map_while(Result::ok) {
            if is_verbose {
                println!("{}", l);
            }
            if let Some(ref f) = log_file_stdout {
                let mut f = f.lock().unwrap();
                writeln!(f, "{}", l).ok();
            }
            output.push_str(&l);
            output.push('\n');
        }
        output
    });

    let stderr_thread = thread::spawn(move || {
        let reader = BufReader::new(stderr_pipe);
        let mut output = String::new();
        for l in reader.lines().map_while(Result::ok) {
            if is_verbose {
                eprintln!("{}", l);
            }
            if let Some(ref f) = log_file_stderr {
                let mut f = f.lock().unwrap();
                writeln!(f, "{}", l).ok();
            }
            output.push_str(&l);
            output.push('\n');
        }
        output
    });

    let stdout_str = stdout_thread.join().unwrap_or_default();
    let stderr_str = stderr_thread.join().unwrap_or_default();

    let status = child.wait().map_err(|e| e.to_string())?;
    if !status.success() {
        let error_msg = if !stderr_str.is_empty() {
            stderr_str.to_string()
        } else {
            stdout_str.to_string()
        };
        return Err(format!(
            "Command '{}' failed (Exit Code: {}). Error: {}",
            full_command,
            status.code().unwrap_or(-1),
            error_msg.trim()
        ));
    }

    Ok(())
}

/// Mevcut çalışma dizinini değiştirir (shelltools.cd muadili).
pub fn cd<P: AsRef<Path>>(path: P) -> Result<(), String> {
    let p = path.as_ref();
    println!("{}", t!("api_cd", path = p.display()));
    env::set_current_dir(p).map_err(|e| t!("api_err_cd", path = p.display(), error = e).to_string())
}

/// COMAR betikleri için gerekli sistem çevre değişkenlerini hazırlar.
pub fn setup_comar_env(pkg_name: &str, dest_root: &str) {
    set_env("PISI_PACKAGE_NAME", pkg_name);
    set_env("PISI_DESTDIR", dest_root);
    // Betiklerin sistem Python kütüphanelerine erişimi için
    if let Ok(path) = env::var("PYTHONPATH") {
        set_env(
            "PYTHONPATH",
            &format!("{}:/usr/lib/python3/site-packages", path),
        );
    } else {
        set_env("PYTHONPATH", "/usr/lib/python3/site-packages");
    }
}

/// Bir çevre değişkenini ayarlar (variable.py ve Flags muadili).
pub fn set_env(key: &str, value: &str) {
    println!("{}", t!("api_set_env", key = key, value = value));
    unsafe { env::set_var(key, value); }
}

/// İnşa süreci için kritik olan 'make' ve 'patch' komutlarının sistemde olup olmadığını denetler.
pub fn check_required_tools() -> Result<(), String> {
    for tool in &["make", "patch"] {
        if Command::new(tool).arg("--version").output().is_err() {
            return Err(t!("api_err_tool_not_found", tool = tool).to_string());
        }
    }
    println!("{}", t!("api_tools_verified"));
    Ok(())
}

/// İndirilen kaynak arşivin doğruluğunu kontrol eder.
pub fn verify_archive(
    archive_path: &str,
    expected_hash: &str,
    algorithm: &str,
) -> Result<(), String> {
    println!(
        "{}",
        t!("api_verify_archive", algo = algorithm, path = archive_path)
    );

    let mut file = fs::File::open(archive_path)
        .map_err(|e| t!("api_err_archive_open", error = e).to_string())?;

    let calculated_hash = match algorithm.to_lowercase().as_str() {
        "sha1" => {
            let mut hasher = Sha1::new();
            io::copy(&mut file, &mut hasher).map_err(|e| e.to_string())?;
            format!("{:x}", hasher.finalize())
        }
        "sha256" => {
            let mut hasher = Sha256::new();
            io::copy(&mut file, &mut hasher).map_err(|e| e.to_string())?;
            format!("{:x}", hasher.finalize())
        }
        "md5" => {
            let mut content = Vec::new();
            file.read_to_end(&mut content).map_err(|e| e.to_string())?;
            format!("{:x}", md5::compute(&content))
        }
        _ => return Err(t!("api_err_hash_algo", algo = algorithm).to_string()),
    };

    if calculated_hash == expected_hash {
        println!("{}", t!("api_archive_success"));
        Ok(())
    } else {
        Err(t!(
            "api_err_hash_mismatch",
            path = archive_path,
            expected = expected_hash,
            calculated = calculated_hash
        )
        .to_string())
    }
}

/// Verilen arşiv dosyasını (tar.gz, tar.xz, zip) mevcut dizine açar.
pub fn unpack_archive(archive_path: &str) -> Result<(), String> {
    println!("{}", t!("api_unpack", path = archive_path));

    let ext = Path::new(archive_path)
        .extension()
        .and_then(|s| s.to_str())
        .unwrap_or("");

    match ext {
        "gz" | "tgz" => run_command("tar", &["-xvf", archive_path]),
        "xz" => run_command("tar", &["-xJvf", archive_path]),
        "zip" => run_command("unzip", &[archive_path]),
        _ => run_command("tar", &["-xvf", archive_path]), // Default tar denemesi
    }
}

/// Kaynak dosya içindeki bir yamayı (patch) uygular.
pub fn do_patch(patch_file: &str, strip_level: u8) -> Result<(), String> {
    let strip = format!("-p{}", strip_level);
    run_command("patch", &["-i", patch_file, &strip])?;
    Ok(())
}

/// Ham bir kabuk komutunu (shell command) sandbox içinde çalıştırır.
/// Spec dosyasındaki 'steps' içeriğini yürütmek için kullanılır.
pub fn run_shell(command: &str) -> Result<(), String> {
    run_command("sh", &["-c", command])
}

/// Kaynak dosyadan hedef dizine dosya veya dizin kopyalar/taşır.
/// Orijinal Pisi'deki pisitools.install() fonksiyonunun muadilidir.
pub fn install<P: AsRef<Path>, D: AsRef<Path>>(source: P, destination: D) -> Result<(), String> {
    let source = source.as_ref();
    let destination = destination.as_ref();

    println!(
        "{}",
        t!(
            "api_install",
            src = source.display(),
            dest = destination.display()
        )
    );
    if let Some(parent) = destination.parent() {
        fs::create_dir_all(parent).map_err(|e| e.to_string())?;
    }

    if source.is_dir() {
        // Dizin ve içeriğini öznitelikleri koruyarak kopyalamak için sistem cp komutunu kullanıyoruz.
        run_command(
            "cp",
            &[
                "-pPR",
                source.to_str().unwrap(),
                destination.to_str().unwrap(),
            ],
        )?;
    } else {
        // Eğer hedef bir dizinse, dosya adını koru
        let final_dest = if destination.is_dir() {
            destination.join(source.file_name().ok_or("Geçersiz kaynak dosya")?)
        } else {
            destination.to_path_buf()
        };

        if let Some(parent) = final_dest.parent() {
            fs::create_dir_all(parent).map_err(|e| e.to_string())?;
        }
        fs::copy(source, &final_dest)
            .map_err(|e| t!("api_err_copy", src = source.display(), error = e).to_string())?;
    }

    Ok(())
}

/// Autotools tabanlı derleme sistemleri için temel configure çağrısını yapar.
pub fn autotools_configure(args: &[&str]) -> Result<(), String> {
    let sbindir_val = std::env::var("PISI_SBINDIR").unwrap_or_else(|_| "usr/bin".to_string());
    let mut default_args = vec!["--prefix=/usr".to_string(), "--sysconfdir=/etc".to_string()];

    // Kullanıcı --sbindir belirtmemişse varsayılanı ekle
    let has_sbindir = args.iter().any(|a| a.starts_with("--sbindir"));
    if !has_sbindir {
        default_args.push(format!("--sbindir=/{}", sbindir_val.trim_start_matches('/')));
    }

    // systemd kontrolü: Kullanıcı --with-systemdsystemunitdir belirtmemişse, systemd olmadığı için =no ekle
    let has_systemd = args.iter().any(|a| a.starts_with("--with-systemdsystemunitdir"));
    if !has_systemd {
        default_args.push("--with-systemdsystemunitdir=no".to_string());
    }

    // libexecdir kontrolü: Kullanıcı --libexecdir belirtmemişse, --libexecdir=/usr/lib/paket_adı ekle
    let has_libexecdir = args.iter().any(|a| a.starts_with("--libexecdir"));
    if !has_libexecdir {
        if let Ok(pkg_name) = std::env::var("SRC_NAME") {
            default_args.push(format!("--libexecdir=/usr/lib/{}", pkg_name));
        }
    }

    // Çapraz derleme kontrolü
    if let Ok(chost) = env::var("CHOST") {
        if !args.iter().any(|arg| arg.starts_with("--host=")) {
            default_args.push(format!("--host={}", chost));
        }
    }

    for arg in args {
        default_args.push(arg.to_string());
    }

    let default_args_refs: Vec<&str> = default_args.iter().map(|s| s.as_str()).collect();

    println!(
        "{}",
        t!("api_run_config", args = default_args_refs.join(" "))
    );

    // run_command ile configure script'ini çalıştır
    run_command("./configure", &default_args_refs)
}

/// Autotools 'libtoolize' adımını uygular.
pub fn libtoolize(args: &[&str]) -> Result<(), String> {
    let mut default_args = vec!["--copy", "--force"];
    default_args.extend_from_slice(args);
    println!("Running libtoolize {}", default_args.join(" "));
    run_command("libtoolize", &default_args)
}

// YENİ FONKSİYONLAR
/// Autotools 'make' (derleme) adımını uygular.
pub fn autotools_make(args: &[&str]) -> Result<(), String> {
    let jobs = get::make_jobs();
    let mut default_args = vec!["-j", jobs.as_str()];
    default_args.extend_from_slice(args);

    println!("{}", t!("api_run_make", args = default_args.join(" ")));

    run_command("make", &default_args)
}

/// CMake tabanlı derleme sistemleri için yapılandırma adımını uygular.
pub fn cmake_configure(args: &[&str]) -> Result<(), String> {
    let sbindir_val = std::env::var("PISI_SBINDIR").unwrap_or_else(|_| "bin".to_string());
    let mut default_args = vec![
        "-DCMAKE_INSTALL_PREFIX=/usr".to_string(),
        "-DCMAKE_BUILD_TYPE=Release".to_string(),
        "-DCMAKE_INSTALL_LIBDIR=lib".to_string(),
        "-DLIB_SUFFIX=".to_string(),
        "-DCMAKE_VERBOSE_MAKEFILE=ON".to_string(),
    ];

    // Kullanıcı CMAKE_INSTALL_SBINDIR belirtmemişse varsayılanı ekle
    let has_sbindir = args.iter().any(|a| a.contains("CMAKE_INSTALL_SBINDIR"));
    if !has_sbindir {
        default_args.push(format!("-DCMAKE_INSTALL_SBINDIR={}", sbindir_val));
    }

    // libexecdir kontrolü: Kullanıcı CMAKE_INSTALL_LIBEXECDIR belirtmemişse, -DCMAKE_INSTALL_LIBEXECDIR=lib/paket_adı ekle
    let has_libexecdir = args.iter().any(|a| a.contains("CMAKE_INSTALL_LIBEXECDIR"));
    if !has_libexecdir {
        if let Ok(pkg_name) = std::env::var("SRC_NAME") {
            default_args.push(format!("-DCMAKE_INSTALL_LIBEXECDIR=lib/{}", pkg_name));
        }
    }

    // Çapraz derleme kontrolü
    if let Ok(chost) = env::var("CHOST") {
        let target_arch = if chost.starts_with("aarch64") {
            "aarch64"
        } else if chost.starts_with("x86_64") {
            "x86_64"
        } else {
            "generic"
        };

        default_args.push("-DCMAKE_SYSTEM_NAME=Linux".to_string());
        default_args.push(format!("-DCMAKE_SYSTEM_PROCESSOR={}", target_arch));

        if let Ok(cc) = env::var("CC") {
            default_args.push(format!("-DCMAKE_C_COMPILER={}", cc));
        }
        if let Ok(cxx) = env::var("CXX") {
            default_args.push(format!("-DCMAKE_CXX_COMPILER={}", cxx));
        }
    }

    for arg in args {
        default_args.push(arg.to_string());
    }

    // cmake .. (hedef dizin olarak son argüman eklenir)
    if !args.iter().any(|arg| arg.starts_with("..")) {
        default_args.push("..".to_string());
    }

    // CMake genellikle ayrı bir build dizini bekler
    if !Path::new("build").exists() {
        fs::create_dir("build").map_err(|e| t!("api_err_build_dir", error = e).to_string())?;
    }

    // Build dizinine gir ve modern run_command mekanizmasıyla çalıştır
    cd("build")?;
    println!("{}", t!("api_run_cmake"));

    let default_args_refs: Vec<&str> = default_args.iter().map(|s| s.as_str()).collect();
    run_command("cmake", &default_args_refs)
}

/// Meson tabanlı derleme sistemleri için yapılandırma adımını uygular.
pub fn meson_configure(args: &[&str]) -> Result<(), String> {
    let mut default_args = vec![
        "setup".to_string(),
        "builddir".to_string(),
        "--prefix=/usr".to_string(),
        "--sysconfdir=/etc".to_string(),
        "--buildtype=plain".to_string(),
        "--libdir=lib".to_string(),
    ];

    // Kullanıcı --sbindir belirtmemişse varsayılanı ekle
    let has_sbindir = args.iter().any(|a| a.starts_with("--sbindir"));
    if !has_sbindir {
        let sbindir_val = std::env::var("PISI_SBINDIR").unwrap_or_else(|_| "bin".to_string());
        default_args.push(format!("--sbindir={}", sbindir_val));
    }

    // libexecdir kontrolü: Kullanıcı --libexecdir belirtmemişse, --libexecdir=lib/paket_adı ekle (Meson'da libdir=lib olduğu için prefix'e göre görece yoldur)
    let has_libexecdir = args.iter().any(|a| a.starts_with("--libexecdir"));
    if !has_libexecdir {
        if let Ok(pkg_name) = std::env::var("SRC_NAME") {
            default_args.push(format!("--libexecdir=lib/{}", pkg_name));
        }
    }

    for arg in args {
        default_args.push(arg.to_string());
    }

    let refs: Vec<&str> = default_args.iter().map(|s| s.as_str()).collect();
    println!("{}", t!("api_run_meson", args = refs.join(" ")));

    run_command("meson", &refs)
}

/// Ninja derleme sistemini kullanarak projeyi derler.
pub fn ninja_build(args: &[&str]) -> Result<(), String> {
    let jobs = get::make_jobs();
    let mut default_args = vec!["-C", "builddir", "-j", jobs.as_str()];
    default_args.extend_from_slice(args);

    println!("{}", t!("api_run_ninja", args = default_args.join(" ")));

    run_command("ninja", &default_args)
}

/// Ninja derleme sistemini kullanarak projeyi kurar.
pub fn ninja_install(dest_dir: &str, args: &[&str]) -> Result<(), String> {
    unsafe { env::set_var("DESTDIR", dest_dir); }
    let jobs = get::make_jobs();
    let mut default_args = vec!["-C", "builddir", "-j", jobs.as_str(), "install"];
    default_args.extend_from_slice(args);

    println!("{}", t!("api_run_ninja_install", dest = dest_dir));

    let res = run_command("ninja", &default_args);

    // Çevre değişkenini temizle
    unsafe { env::remove_var("DESTDIR"); }

    res
}

/// Autotools 'make install' (kurulum) adımını uygular.
pub fn autotools_install(dest_dir: &str, args: &[&str]) -> Result<(), String> {
    let jobs = get::make_jobs();
    let destdir_arg = format!("DESTDIR={}", dest_dir);
    let mut default_args = vec!["-j", jobs.as_str(), "install", destdir_arg.as_str()];
    default_args.extend_from_slice(args);

    println!("{}", t!("api_run_make_install", dest = dest_dir));

    // make komutunu 'install' argümanı ve DESTDIR ile çalıştır
    run_command("make", &default_args)
}

/// Autotools 'make install' ham kurulum adımı. DESTDIR otomatik eklenmez,
/// argümanlar doğrudan kullanıcıdan gelir (rawInstall muadili).
pub fn raw_install(args: &[&str]) -> Result<(), String> {
    let jobs = get::make_jobs();
    let mut default_args = vec!["-j", jobs.as_str(), "install"];
    default_args.extend_from_slice(args);

    println!("{}", t!("api_run_make", args = default_args.join(" ")));

    run_command("make", &default_args)
}

/// Derleme bayraklarını çevre değişkenlerine aktarır
pub fn export_flags() {
    set_env("CFLAGS", &get::cflags());
    set_env("CXXFLAGS", &get::cxxflags());
    set_env("LDFLAGS", &get::ldflags());
}

// --- PISITOOLS ÖZGÜ FONKSİYONLAR ---

/// Bin dosyalarını /usr/bin dizinine kurar.
pub fn dobin<P: AsRef<Path>>(dest_root: &str, source: P) -> Result<(), String> {
    let path = Path::new(dest_root).join("usr/bin");
    fs::create_dir_all(&path).map_err(|e| e.to_string())?;
    install(source, path)
}

/// Sistem bin dosyalarını /usr/bin dizinine kurar (usrmerge).
/// /usr/sbin gerektiren programlar için /usr/sbin'de sembolik bağ oluşturur.
pub fn dosbin<P: AsRef<Path>>(dest_root: &str, source: P) -> Result<(), String> {
    let sbindir = std::env::var("PISI_SBINDIR").unwrap_or_else(|_| "usr/bin".to_string());
    let target_dir = Path::new(dest_root).join(&sbindir);
    fs::create_dir_all(&target_dir).map_err(|e| e.to_string())?;

    // Kaynak dosya adını al (install çağrısından önce, move sorununu önlemek için)
    let filename = source
        .as_ref()
        .file_name()
        .map(|n| n.to_string_lossy().to_string());

    install(source, &target_dir)?;

    // sbindir usr/bin değilse (ör. usr/sbin), sembolik bağ gerekmez
    if sbindir == "usr/sbin" {
        return Ok(());
    }

    // /usr/sbin gerektiren programlar için sembolik bağlantı oluştur:
    // install_root/usr/sbin/program -> ../bin/program
    let sbin_link_dir = Path::new(dest_root).join("usr/sbin");
    if let Some(parent) = sbin_link_dir.parent() {
        fs::create_dir_all(parent).map_err(|e| e.to_string())?;
    }

    if let Some(ref fname) = filename {
        let link_path = sbin_link_dir.join(fname);
        if !link_path.exists() {
            #[cfg(unix)]
            std::os::unix::fs::symlink(
                format!("../bin/{}", fname),
                &link_path,
            )
            .map_err(|e| {
                t!(
                    "api_symlink_err",
                    error = format!("{} -> usr/sbin: {}", fname, e)
                )
                .to_string()
            })?;
        }
    }

    Ok(())
}

/// Kütüphaneleri /usr/lib dizinine kurar.
pub fn dolib<P: AsRef<Path>>(dest_root: &str, source: P) -> Result<(), String> {
    let path = Path::new(dest_root).join("usr/lib");
    fs::create_dir_all(&path).map_err(|e| e.to_string())?;
    install(source, path)
}

/// Manual sayfalarını /usr/share/man dizinine kurar.
pub fn doman<P: AsRef<Path>>(dest_root: &str, source: P) -> Result<(), String> {
    let path = Path::new(dest_root).join("usr/share/man");
    fs::create_dir_all(&path).map_err(|e| e.to_string())?;
    install(source, path)
}

/// Info sayfalarını /usr/share/info dizinine kurar.
pub fn doinfo<P: AsRef<Path>>(dest_root: &str, source: P) -> Result<(), String> {
    let path = Path::new(dest_root).join("usr/share/info");
    fs::create_dir_all(&path).map_err(|e| e.to_string())?;
    install(source, path)
}

/// Dokümantasyon dosyalarını /usr/share/doc/<paket_adi> dizinine kurar.
pub fn dodoc<P: AsRef<Path>>(dest_root: &str, pkg_name: &str, source: P) -> Result<(), String> {
    let path = Path::new(dest_root).join("usr/share/doc").join(pkg_name);
    fs::create_dir_all(&path).map_err(|e| e.to_string())?;
    install(source, path)
}

/// C/C++ başlık dosyalarını /usr/include dizinine kurar.
pub fn install_headers<P: AsRef<Path>>(dest_root: &str, source: P) -> Result<(), String> {
    let path = Path::new(dest_root).join("usr/include");
    fs::create_dir_all(&path).map_err(|e| e.to_string())?;

    let src_str = source.as_ref().to_string_lossy();
    if src_str.contains('*') || src_str.contains('?') {
        if let Ok(entries) = glob::glob(&src_str) {
            for entry in entries.flatten() {
                install(&entry, &path)?;
            }
        }
        Ok(())
    } else {
        install(source, path)
    }
}

/// Bir dosya içindeki metni arar ve değiştirir (sed -i alternatifi).
pub fn dosed<P: AsRef<Path>>(
    path: P,
    search: &str,
    replace: &str,
    delete_line: bool,
) -> Result<(), String> {
    let p = path.as_ref();
    println!(
        "-> dosed: {} ({} -> {})",
        p.display(),
        search,
        if delete_line { "DELETE" } else { replace }
    );

    let content = fs::read_to_string(p)
        .map_err(|e| t!("api_err_dosed_open", path = p.display(), error = e).to_string())?;

    let re = regex::Regex::new(search).map_err(|e| t!("api_err_regex", error = e).to_string())?;

    let mut new_lines = Vec::new();
    for line in content.lines() {
        if re.is_match(line) {
            if !delete_line {
                new_lines.push(re.replace_all(line, replace).to_string());
            }
        } else {
            new_lines.push(line.to_string());
        }
    }

    fs::write(p, new_lines.join("\n") + "\n")
        .map_err(|e| t!("api_err_dosed_write", path = p.display(), error = e).to_string())
}
