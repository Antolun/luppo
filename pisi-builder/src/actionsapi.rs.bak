/// Info dir dosyasını temizler (autotools.fixInfoDir muadili).
pub fn fix_info_dir(dest_root: &str) -> Result<(), String> {
    let info_dir = Path::new(dest_root).join("usr/share/info/dir");
    if info_dir.exists() {
        println!("{}", t!("api_fix_info_dir", path = info_dir.display()));
        fs::remove_file(&info_dir).map_err(|e| t!("api_fix_info_dir_err", error = e).to_string())
    } else {
        Ok(())
    }
}

/// HTML doküman kurulumu (pisitools.dohtml muadili).
pub fn dohtml(dest_root: &str, sources: &[&str], dest_dir: Option<&str>) -> Result<(), String> {
    let pkg_name = env::var("SRC_NAME").unwrap_or_else(|_| "unknown".to_string());
    let sub_dir = dest_dir.unwrap_or(&pkg_name);
    let target = Path::new(dest_root)
        .join(get::doc_dir())
        .join(sub_dir)
        .join("html");
    fs::create_dir_all(&target).map_err(|e| e.to_string())?;

    for src in sources {
        run_command("cp", &["-pPR", src, target.to_str().unwrap()])?;
    }
    Ok(())
}

/// MO dosyası oluşturma ve kurulumu (pisitools.domo muadili).
pub fn domo(
    dest_root: &str,
    source: &str,
    locale: &str,
    destination_file: &str,
) -> Result<(), String> {
    let target_dir = Path::new(dest_root)
        .join("usr/share/locale")
        .join(locale)
        .join("LC_MESSAGES");
    fs::create_dir_all(&target_dir).map_err(|e| e.to_string())?;

    run_command("msgfmt", &[source, "-o", "messages.mo"])?;
    fs::rename("messages.mo", target_dir.join(destination_file)).map_err(|e| e.to_string())
}

/// Yeni doküman kurulumu (pisitools.newdoc muadili).
pub fn newdoc(dest_root: &str, source: &str, destination: &str) -> Result<(), String> {
    let pkg_name = env::var("SRC_NAME").unwrap_or_else(|_| "unknown".to_string());
    let dest_path = Path::new(destination);
    let dest_dir = dest_path
        .parent()
        .map(|p| p.to_str().unwrap_or(""))
        .unwrap_or("");
    let dest_file = dest_path
        .file_name()
        .ok_or("Geçersiz hedef dosya")?
        .to_str()
        .unwrap();

    let target_dir = Path::new(dest_root)
        .join(get::doc_dir())
        .join(pkg_name)
        .join(dest_dir);
    fs::create_dir_all(&target_dir).map_err(|e| e.to_string())?;

    fs::copy(source, target_dir.join(dest_file))
        .map(|_| ())
        .map_err(|e| e.to_string())
}

/// Yeni man sayfası kurulumu (pisitools.newman muadili).
pub fn newman(dest_root: &str, source: &str, destination: &str) -> Result<(), String> {
    let dest_path = Path::new(destination);
    let section = dest_path
        .extension()
        .ok_or("Man sayfasının uzantısı (section) yok")?
        .to_str()
        .unwrap();
    let target_dir = Path::new(dest_root)
        .join(get::man_dir())
        .join(format!("man{}", section));
    fs::create_dir_all(&target_dir).map_err(|e| e.to_string())?;

    fs::copy(source, target_dir.join(dest_path.file_name().unwrap()))
        .map(|_| ())
        .map_err(|e| e.to_string())
}
